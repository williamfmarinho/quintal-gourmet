# ---------------------------------------------------------------------
# Modelo de configuração. Copie para .env.local e preencha os valores.
# O arquivo .env.local NUNCA vai para o Git.
# ---------------------------------------------------------------------

# Onde os dados ficam: "excel" (planilha local) ou "postgres" (Supabase).
# Sem esta linha, o sistema usa postgres quando DATABASE_URL existe.
ARMAZENAMENTO=postgres

# Conexão do Supabase — use o TRANSACTION POOLER (porta 6543).
# Painel do Supabase → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo usado para assinar os tokens de sessão (qualquer texto longo e aleatório).
SESSAO_SEGREDO=troque-por-um-valor-aleatorio-bem-longo

# Porta do servidor local (opcional)
PORTA=4321
